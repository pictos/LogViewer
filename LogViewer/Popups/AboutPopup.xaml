<?xml version="1.0" encoding="utf-8" ?>
<Border
	x:Class="LogViewer.Popups.AboutPopup"
	xmlns="http://schemas.microsoft.com/dotnet/maui/global"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:local="clr-namespace:LogViewer"
	Padding="20"
	Background="{StaticResource AboutPopupSurface}"
	Stroke="{StaticResource AboutPopupAccent}"
	StrokeShape="{RoundRectangle CornerRadius=20}">

	<VerticalStackLayout Spacing="14">
		<Label
			FontAttributes="Bold"
			FontSize="26"
			HorizontalOptions="Center"
			Text="LogViewer"
			TextColor="{StaticResource AboutPopupTextPrimary}" />

		<Label
			FontSize="14"
			HorizontalOptions="Center"
			TextColor="{StaticResource AboutPopupAccent}">
			<Label.FormattedText>
				<FormattedString>
					<Span Text="Version " />
					<Span FontAttributes="Bold" Text="{x:Static local:Contants.Version}" />
				</FormattedString>
			</Label.FormattedText>
		</Label>

		<Label
			FontSize="15"
			HorizontalOptions="Center"
			Text="Created by Pedro Jesus"
			TextColor="{StaticResource AboutPopupTextSecondary}" />

		<Label
			FontSize="13"
			HorizontalOptions="Center"
			Text="PJSouzaSoftware Inc."
			TextColor="{StaticResource AboutPopupTextSecondary}" />

		<HorizontalStackLayout HorizontalOptions="Center" Spacing="3">
			<Label
				HorizontalTextAlignment="Center"
				LineBreakMode="WordWrap"
				Text="You can contract my services at "
				TextColor="{StaticResource AboutPopupTextSecondary}" />
			<Label
				HorizontalTextAlignment="Center"
				LineBreakMode="WordWrap"
				TextColor="{StaticResource AboutPopupTextSecondary}">

				<Label.Behaviors>
					<MouseCursorPlatformBehavior HoverCursor="Hand" />
				</Label.Behaviors>

				<Label.FormattedText>
					<FormattedString>
						<Span
							FontAttributes="Bold"
							Text="PJSouzaSoftware"
							TextColor="{StaticResource AboutPopupAccent}">
							<Span.GestureRecognizers>
								<TapGestureRecognizer Tapped="OnContactTapped" />
							</Span.GestureRecognizers>
						</Span>
						<Span Text="." />
					</FormattedString>
				</Label.FormattedText>
			</Label>
		</HorizontalStackLayout>

		<Button
			Background="{StaticResource AboutPopupAccent}"
			Clicked="OnCloseClicked"
			CornerRadius="10"
			FontAttributes="Bold"
			HorizontalOptions="Center"
			Text="Close"
			TextColor="White"
			WidthRequest="140" />
	</VerticalStackLayout>
</Border>
