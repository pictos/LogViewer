<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
		<OutputType Condition="'$(IsDeviceTestProject)' == 'true'">Library</OutputType>
		<OutputType Condition="'$(IsDeviceTestProject)' != 'true'">Exe</OutputType>

		<RootNamespace>LogViewer</RootNamespace>

		<!-- Display name -->
		<ApplicationTitle>LogViewer</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.logviewer</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>
		
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
		<PackageReference Include="Nalu.Maui.VirtualScroll" Version="10.7.8" />
		<PackageReference Include="PJSouzaSoftware.Core" Version="0.0.1" />
		<PackageReference Include="PJSouzaSoftware.Gestures.Maui" Version="99.0.0-preview65" />
	</ItemGroup>


	<!-- Region for configure DeviceTest -->

	<!-- When referenced as a library (e.g. from DeviceTests), use separate output/intermediate
       directories so VS's Fast Up-To-Date check cannot reuse stale app-mode build artifacts.
       Also re-add the standard bin/obj exclusions: changing BaseOutputPath removes them from
       the SDK's default glob exclusions, causing XAML source generators to pick up stale files. -->
	<PropertyGroup Condition="'$(IsDeviceTestProject)' == 'true'">
		<BaseOutputPath>bin\library\</BaseOutputPath>
		<BaseIntermediateOutputPath>obj\library\</BaseIntermediateOutputPath>
		<DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);bin\**\*;obj\**\*</DefaultItemExcludesInProjectFolder>
	</PropertyGroup>

	<!-- When referenced as a library (e.g. from DeviceTests), suppress platform-specific
       app packaging to prevent resource conflicts in the consuming app. -->
	<PropertyGroup Condition="'$(IsDeviceTestProject)' == 'true' And '$(IsWindows)' == 'true'">
		<WindowsPackageType>None</WindowsPackageType>
		<GenerateLibraryLayout>false</GenerateLibraryLayout>
		<AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
		<!-- Prevent GetPriOutputs from returning this project's PRI (which doesn't exist) or
		     transitive NuGet package PRIs to the consuming app. -->
		<IncludeProjectPriFile>false</IncludeProjectPriFile>
		<IncludePriFilesOutputGroup>false</IncludePriFilesOutputGroup>
		<IncludeCopyLocalFilesOutputGroup>false</IncludeCopyLocalFilesOutputGroup>
	</PropertyGroup>


	<ItemGroup Condition="$(IsDeviceTestProject)">
		<MauiIcon Remove="@(MauiIcon)" />
		<MauiSplashScreen Remove="@(MauiSplashScreen)" />
	</ItemGroup>

	<!-- When referenced as a library, exclude Windows entry-point files that would produce XBF
	     artifacts (App.xbf) and conflict with the consuming app's own ApplicationDefinition. -->
	<ItemGroup Condition="'$(IsDeviceTestProject)' == 'true' And '$(IsWindows)' == 'true'">
		<ApplicationDefinition Remove="Platforms\Windows\**" />
		<Page Remove="Platforms\Windows\**" />
		<Compile Remove="Platforms\Windows\**" />
		<Manifest Remove="Platforms\Windows\**" />
		<AppxManifest Remove="Platforms\Windows\**" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Resources\Images\" />
	</ItemGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="LogViewer.DeviceTests" />
	</ItemGroup>
</Project>
