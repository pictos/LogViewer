<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="LogViewer.LogPage"
	xmlns="http://schemas.microsoft.com/dotnet/maui/global"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:DataType="LogViewModel">

	<Grid
		x:Name="mainLayout"
		x:FieldModifier="internal"
		RowDefinitions="auto, *">

		<Grid.GestureRecognizers>
			<DropGestureRecognizer AllowDrop="True" Drop="DropGestureRecognizer_Drop" />
		</Grid.GestureRecognizers>

		<ScrollView Orientation="Horizontal" VerticalScrollBarVisibility="Never">
			<FlexLayout
				x:Name="tabsLayout"
				Padding="5,0"
				x:FieldModifier="internal"
				FlexLayout.Shrink="0.25"
				Wrap="NoWrap" />
		</ScrollView>

		<!--  LoggerContent will be added programatically  -->
	</Grid>
</ContentPage>