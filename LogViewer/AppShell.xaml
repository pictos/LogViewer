<?xml version="1.0" encoding="UTF-8" ?>
<Shell
	x:Class="LogViewer.AppShell"
	xmlns="http://schemas.microsoft.com/dotnet/maui/global"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:DataType="ShellViewModel">

	<Shell.BindingContext>
		<ShellViewModel />
	</Shell.BindingContext>

	<Shell.MenuBarItems>
		<MenuBarItem Text="File">
			<MenuFlyoutItem Command="{Binding OpenFileCommand}" Text="Open..." />
			<MenuFlyoutItem Command="{Binding OpenSideBySideCommand}" Text="Open side by side..." />
		</MenuBarItem>
	</Shell.MenuBarItems>

	<ShellContent ContentTemplate="{DataTemplate LogPage}" Route="LogPage" />
	<!--<ShellContent ContentTemplate="{DataTemplate MainPage}" Route="LogPage" />-->
</Shell>
