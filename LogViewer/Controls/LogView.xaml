<?xml version="1.0" encoding="utf-8" ?>
<Grid
	x:Class="LogViewer.Controls.LogView"
	xmlns="http://schemas.microsoft.com/dotnet/maui/global"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:nalu="clr-namespace:Nalu;assembly=Nalu.Maui.VirtualScroll"
	x:Name="this"
	x:DataType="LogViewModel"
	RowDefinitions="*, 22">
	<DockLayout>
		<Entry
			DockLayout.DockPosition="Top"
			Placeholder="Filter"
			Text="{Binding Query}">
			<Entry.Behaviors>
				<UserStoppedTypingBehavior Command="{Binding BindingContext.FilterCommand, Source={x:Reference this}}" StoppedTypingTimeThreshold="100" />
			</Entry.Behaviors>
		</Entry>
		<nalu:VirtualScroll DockLayout.DockPosition="None" ItemsSource="{Binding LogSource}">
			<nalu:VirtualScroll.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<Editor
						Margin="10,0"
						IsReadOnly="True"
						Text="{Binding .}"
						VerticalTextAlignment="Center" />
				</DataTemplate>
			</nalu:VirtualScroll.ItemTemplate>
		</nalu:VirtualScroll>
	</DockLayout>
	<Label
		Grid.Row="1"
		Background="LightGray"
		Text="{Binding Status}"
		TextColor="Black" />
</Grid>