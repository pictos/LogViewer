<?xml version="1.0" encoding="utf-8" ?>
<mct:DockLayout
	x:Class="LogViewer.Controls.LogView"
	xmlns="http://schemas.microsoft.com/dotnet/maui/global"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:nalu="clr-namespace:Nalu;assembly=Nalu.Maui.VirtualScroll"
	x:DataType="LogViewModel">

	<Entry DockLayout.DockPosition="Top" Placeholder="Filter" />
	<nalu:VirtualScroll DockLayout.DockPosition="None" ItemsSource="{Binding LogSource}">
		<nalu:VirtualScroll.ItemTemplate>
			<DataTemplate x:DataType="x:String">
				<Label Padding="10,0" Text="{Binding .}" />
			</DataTemplate>
		</nalu:VirtualScroll.ItemTemplate>
	</nalu:VirtualScroll>

</mct:DockLayout>
