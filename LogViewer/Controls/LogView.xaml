<?xml version="1.0" encoding="utf-8" ?>
<Grid
	x:Class="LogViewer.Controls.LogView"
	xmlns="http://schemas.microsoft.com/dotnet/maui/global"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:nalu="clr-namespace:Nalu;assembly=Nalu.Maui.VirtualScroll"
	x:Name="this"
	x:DataType="LogViewModel"
	RowDefinitions="auto, *, 22">

	<Entry
		DockLayout.DockPosition="Top"
		Placeholder="Filter"
		Text="{Binding Query}">
		<Entry.Behaviors>
			<UserStoppedTypingBehavior Command="{Binding BindingContext.FilterCommand, Source={x:Reference this}}" StoppedTypingTimeThreshold="100" />
		</Entry.Behaviors>
	</Entry>
	<DockLayout
		x:Name="dock"
		Grid.Row="1"
		x:FieldModifier="internal">
		<LogContent DockLayout.DockPosition="None" />
	</DockLayout>
	<Label
		Grid.Row="2"
		Background="LightGray"
		Text="{Binding Status}"
		TextColor="Black" />
</Grid>