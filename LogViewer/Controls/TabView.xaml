<?xml version="1.0" encoding="utf-8" ?>
<Border
	x:Class="LogViewer.Controls.TabView"
	xmlns="http://schemas.microsoft.com/dotnet/maui/global"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:DataType="LogViewModel"
	Background="Black"
	StrokeShape="{RoundRectangle CornerRadius='10,10,0,0'}"
	TranslationY="1">
	<Grid ColumnDefinitions="*, 30" ColumnSpacing="8">
		<Label
			Padding="10"
			LineBreakMode="TailTruncation"
			Text="{Binding FileName}"
			TextColor="White"
			VerticalTextAlignment="Center" />
		<Grid Grid.Column="1" Background="Chocolate">
			<Label
				Padding="5"
				FontAttributes="Bold"
				FontSize="16"
				HorizontalTextAlignment="Center"
				Text="X"
				VerticalTextAlignment="Center" />
			<Grid.GestureRecognizers>
				<TapGestureRecognizer Command="{Binding CloseCommand}" />
			</Grid.GestureRecognizers>
		</Grid>

	</Grid>
</Border>
