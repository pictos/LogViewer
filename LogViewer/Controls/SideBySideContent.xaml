<?xml version="1.0" encoding="utf-8" ?>
<Grid
	x:Class="LogViewer.Controls.SideBySideContent"
	xmlns="http://schemas.microsoft.com/dotnet/maui/global"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="this"
	x:DataType="SideBySideViewModel"
	RowDefinitions="auto, *">

	<Grid.GestureRecognizers>
		<DropGestureRecognizer AllowDrop="True" Drop="DropGestureRecognizer_Drop" />
	</Grid.GestureRecognizers>

	<Entry
		x:Name="globalFilter"
		Margin="5,0"
		x:FieldModifier="internal"
		IsVisible="False"
		Placeholder="Global filter"
		Text="{Binding Query}">
		<Entry.Behaviors>
			<UserStoppedTypingBehavior Command="{Binding BindingContext.GlobalFilterCommand, Source={x:Reference this}}" StoppedTypingTimeThreshold="100" />
		</Entry.Behaviors>
	</Entry>

	<Grid
		x:Name="columns"
		Grid.Row="1"
		Padding="5"
		x:FieldModifier="internal"
		ColumnSpacing="5" />
</Grid>
